NUXT_PUBLIC_ENVIRONMENT=local # local | production
NUXT_SITE_URL=http://localhost:3000
NUXT_APP_SECRET= # pnpm generate:secret
NUXT_LOG_LEVEL= # trace | debug | info | warn | error (empty: debug locally, info otherwise)

NUXT_DATABASE_HOST=localhost
NUXT_DATABASE_PORT=5432
NUXT_DATABASE_USER=
NUXT_DATABASE_PASS=
NUXT_DATABASE_NAME=watcher

NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

NUXT_OAUTH_TWITCH_PLAYER_CLIENT_ID=
NUXT_OAUTH_TWITCH_CLIENT_ID=
NUXT_OAUTH_TWITCH_CLIENT_SECRET=

# pnpm generate:secret
NUXT_ENCRYPTION_CREDENTIALS_ACCESS_TOKEN=
NUXT_ENCRYPTION_CREDENTIALS_REFRESH_TOKEN=

NUXT_IMAGES_DRIVER=s3 # filesystem | s3
NUXT_IMAGES_PUBLIC_URL= # e.g. https://<bucket>.s3.fr-par.scw.cloud
NUXT_IMAGES_S3_ENDPOINT= # e.g. https://s3.fr-par.scw.cloud
NUXT_IMAGES_S3_REGION= # e.g. fr-par
NUXT_IMAGES_S3_BUCKET=
NUXT_IMAGES_S3_ACCESS_KEY_ID=
NUXT_IMAGES_S3_SECRET_ACCESS_KEY=
NUXT_IMAGES_S3_FORCE_PATH_STYLE=false # true for <endpoint>/<bucket> (MinIO, Garage)
NUXT_IMAGES_S3_STORAGE_CLASS= # e.g. ONEZONE_IA for Scaleway One Zone (empty: the default of the provider)
